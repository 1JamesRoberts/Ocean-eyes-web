{
  "name": "oceaneyes-functions",
  "description": "OceanEyes alert and LiveKit callable functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "test:rules": "node --test test/firestore_rules.emulator.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.6.0",
    "livekit-server-sdk": "^2.15.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^22.15.0",
    "firebase": "^12.17.1",
    "typescript": "^5.9.3"
  }
}
