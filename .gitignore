# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Production configuration generated or supplied per environment
/android/app/google-services.json
/android/key.properties
/ios/Runner/GoogleService-Info.plist
/web/firebase-messaging-sw.js
**/.env
**/.env.*
!**/.env.example
/config/*.json
/config/*.plist
!/config/production.example.json
.runtimeconfig.json
.secret.local
*.p8
*.p12
*.jks
*.keystore

# Alternate on-device inference formats are not part of the Android bundle.
/assets/models/*.ort
/assets/models/*.tflite
